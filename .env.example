# ─── Core ─────────────────────────────────────────────────────────────────────
# Production (Vercel): use Vercel Postgres — DATABASE_URL is auto-injected
# when you connect a Postgres store in the Vercel dashboard.
# Local dev: either run `docker run -p 5432:5432 -e POSTGRES_PASSWORD=pg postgres:16`
# or point at a Neon/Supabase branch.
DATABASE_URL="postgresql://user:password@host:5432/daily_progress?sslmode=require"
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Admins (comma-separated) ─────────────────────────────────────────────────
ADMIN_EMAILS="you@example.com"
ADMIN_PASSWORD="ChangeMe!123"
ADMIN_NAME="You"

# ─── Public landing page branding ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_OWNER_NAME="You"
NEXT_PUBLIC_SITE_TAGLINE="Daily work progress — read-only public view."

# ─── AI summary (optional) ────────────────────────────────────────────────────
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-3-5-haiku-latest"
